PARSER_BEGIN(CompiladorExp)
package com.example.parser;

import java.io.*;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class CompiladorExp {

    public static Map<String, Double> memoria = new HashMap<String, Double>();
    private static Scanner teclado = new Scanner(System.in);

    public static void executar(String codigo) {
        try {
            Reader reader = new StringReader(codigo);
            CompiladorExp parser = new CompiladorExp(reader);
            parser.programa();
        } catch (ParseException e) {
            Token t = e.currentToken.next;
            int lin = (t != null) ? t.beginLine : 0;
            int col = (t != null) ? t.beginColumn : 0;
            String sim = (t != null) ? t.image : "";
            System.out.println("[ERRO SINTATICO] Linha " + lin + ", Coluna " + col + ": Simbolo inesperado '" + sim + "'.");
        } catch (Throwable e) {
            System.out.println("[ERRO LEXICO] " + e.getMessage());
        }
    }
}
PARSER_END(CompiladorExp)

SKIP :
{
    " " | "\t" | "\n" | "\r"
|   <"//" (~["\n", "\r"])*>
}

TOKEN :
{
    < PA: "pa" >
|   < MU: "mu" >
|   < PARETIR: "paretir" >
|   < MUREPETI: "murepeti" >
|   < PALER: "paler" >
|   < MULER: "muler" >
|   < PAESCREVE: "paescreve" >
|   < MUECREVE: "muecreve" >

|   < ABRE_CHAVE: "{" >
|   < FECHA_CHAVE: "}" >
|   < ABRE_PAR: "(" >
|   < FECHA_PAR: ")" >
|   < PONTO_VIRGULA: ";" >
|   < ATRIBUICAO: "=" >

|   < MENOR_IGUAL: "<=" >
|   < MAIOR_IGUAL: ">=" >
|   < IGUAL_DUPLO: "==" >
|   < DIFERENTE: "!=" >
|   < MENOR: "<" >
|   < MAIOR: ">" >

|   < MAIS: "+" >
|   < MENOS: "-" >
|   < VEZES: "*" >
|   < DIVIDIR: "/" >

|   < NUMERO: (["0"-"9"])+ ("." (["0"-"9"])+)? >
|   < IDENTIFICADOR: ["a"-"z", "A"-"Z", "_"] (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
}

void programa() :
{}
{
    listaComandos() <EOF>
}

void bloco() :
{}
{
    <ABRE_CHAVE> listaComandos() <FECHA_CHAVE>
}

void listaComandos() :
{}
{
    ( comando() )+
}

void comando() :
{
    double r;
}
{
    LOOKAHEAD(2) atribCmd()
|   condCmd()
|   repetCmd()
|   leitCmd()
|   escrCmd()
|   r = exp() [ <PONTO_VIRGULA> ]
    {
        System.out.println("[SAIDA ACESSIVEL] O resultado da expressao e: " + r);
    }
}

void atribCmd() :
{
    Token id;
    double valor;
}
{
    id = <IDENTIFICADOR> <ATRIBUICAO> valor = exp() <PONTO_VIRGULA>
    {
        memoria.put(id.image, valor);
    }
}

void condCmd() :
{}
{
    <PA> <ABRE_PAR> exp() <FECHA_PAR> bloco() [ LOOKAHEAD(1) <MU> bloco() ]
}

void repetCmd() :
{}
{
    <PARETIR> <ABRE_PAR> exp() <FECHA_PAR> bloco()
|   <MUREPETI> <ABRE_PAR> exp() <FECHA_PAR> bloco()
}

void leitCmd() :
{
    Token id;
}
{
    ( <MULER> | <PALER> ) <ABRE_PAR> id = <IDENTIFICADOR> <FECHA_PAR> [ <PONTO_VIRGULA> ]
    {
        System.out.print("Digite o valor de " + id.image + ": ");
        try {
            double v = teclado.nextDouble();
            memoria.put(id.image, v);
        } catch (Exception e) {
            memoria.put(id.image, 0.0);
            teclado.nextLine();
        }
    }
}

void escrCmd() :
{
    double val;
}
{
    ( <MUECREVE> | <PAESCREVE> ) <ABRE_PAR> val = exp() <FECHA_PAR> [ <PONTO_VIRGULA> ]
    {
        System.out.println("[SAIDA ACESSIVEL] O resultado da expressao e: " + val);
    }
}

double exp() :
{
    double v1, v2;
    String op = null;
}
{
    v1 = expSimples()
    [
        op = opRelacional() v2 = expSimples()
        {
            if ("<".equals(op)) return (v1 < v2) ? 1.0 : 0.0;
            if ("<=".equals(op)) return (v1 <= v2) ? 1.0 : 0.0;
            if (">".equals(op)) return (v1 > v2) ? 1.0 : 0.0;
            if (">=".equals(op)) return (v1 >= v2) ? 1.0 : 0.0;
            if ("==".equals(op)) return (v1 == v2) ? 1.0 : 0.0;
            if ("!=".equals(op)) return (v1 != v2) ? 1.0 : 0.0;
        }
    ]
    {
        return v1;
    }
}

String opRelacional() :
{
    Token op;
}
{
    ( op = <MENOR_IGUAL> | op = <MAIOR_IGUAL> | op = <IGUAL_DUPLO> | op = <DIFERENTE> | op = <MENOR> | op = <MAIOR> )
    {
        return op.image;
    }
}

double expSimples() :
{
    double total;
    double termo;
    String op;
}
{
    total = termo()
    (
        op = opSoma() termo = termo()
        {
            if ("+".equals(op)) total += termo;
            else if ("-".equals(op)) total -= termo;
        }
    )*
    {
        return total;
    }
}

String opSoma() :
{
    Token op;
}
{
    ( op = <MAIS> | op = <MENOS> )
    {
        return op.image;
    }
}

double termo() :
{
    double total;
    double fator;
    String op;
}
{
    total = fator()
    (
        LOOKAHEAD(opMult())
        op = opMult()
        fator = fator()
        {
            if ("*".equals(op)) total *= fator;
            else if ("/".equals(op)) total = (fator != 0) ? (total / fator) : 0;
        }
    |
        LOOKAHEAD(<ABRE_PAR>)
        fator = fator()
        {
            total *= fator; // Multiplicação implícita: 2(12) => 24
        }
    )*
    {
        return total;
    }
}

String opMult() :
{
    Token op;
}
{
    ( op = <VEZES> | op = <DIVIDIR> )
    {
        return op.image;
    }
}

double fator() :
{
    double v;
    Token t;
}
{
    <ABRE_PAR> v = exp() <FECHA_PAR> { return v; }
|   t = <NUMERO> { return Double.parseDouble(t.image); }
|   t = <IDENTIFICADOR>
    {
        if (memoria.containsKey(t.image)) {
            return memoria.get(t.image);
        }
        System.out.println("[AVISO] Variavel '" + t.image + "' nao declarada. Assumindo 0.");
        return 0.0;
    }
}
