options {
    STATIC = false;
}

PARSER_BEGIN(CompiladorExp)
package com.example.parser;

import com.example.ast.*;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Scanner;

public class CompiladorExp {

    public static Map<String, Double> memoria = new HashMap<String, Double>();
    private static Scanner teclado = new Scanner(System.in).useLocale(Locale.US);

    public static void limparMemoria() {
        memoria.clear();
    }

    public static void executar(String codigo) {
        Ambiente env = new Ambiente(memoria, teclado, System.out);
        executar(codigo, env);
    }

    public static void executar(String codigo, InputStream entrada, PrintStream saida) {
        Ambiente env = new Ambiente(memoria, entrada, saida);
        executar(codigo, env);
    }

    public static void executarArquivo(Path caminho) throws IOException {
        String codigo = Files.readString(caminho, StandardCharsets.UTF_8);
        executar(codigo);
    }

    public static void executar(String codigo, Ambiente env) {
        try {
            Reader reader = new StringReader(codigo);
            CompiladorExp parser = new CompiladorExp(reader);
            Comando prog = parser.programa();
            prog.executar(env);
        } catch (ParseException e) {
            Token t = (e.currentToken != null) ? e.currentToken.next : null;
            int lin = (t != null) ? t.beginLine : 0;
            int col = (t != null) ? t.beginColumn : 0;
            String sim = (t != null) ? t.image : "";
            env.escrever("[ERRO SINTATICO] Linha " + lin + ", Coluna " + col + ": Simbolo inesperado '" + sim + "'.");
        } catch (TokenMgrError e) {
            env.escrever("[ERRO LEXICO] " + e.getMessage());
        } catch (RuntimeException e) {
            env.escrever("[ERRO DE EXECUCAO] " + e.getMessage());
        }
    }
}
PARSER_END(CompiladorExp)

SKIP :
{
    " " | "\t" | "\n" | "\r"
|   <"//" (~["\n", "\r"])*>
|   <"/*" (~["*"])* "*" (~["/"] (~["*"])* "*")* "/">
}

TOKEN :
{
    < PA: "pa" >
|   < MU: "mu" >
|   < PARETIR: "paretir" >
|   < MUREPETI: "murepeti" >
|   < PALER: "paler" >
|   < MULER: "muler" >
|   < PAESCREVE: "paescreve" >
|   < MUESCREVE: "MUESCREVE" | "muescreve" >

|   < ABRE_CHAVE: "{" >
|   < FECHA_CHAVE: "}" >
|   < ABRE_PAR: "(" >
|   < FECHA_PAR: ")" >
|   < PONTO_VIRGULA: ";" >
|   < ATRIBUICAO: "=" >

|   < MENOR_IGUAL: "<=" >
|   < MAIOR_IGUAL: ">=" >
|   < IGUAL_DUPLO: "==" >
|   < DIFERENTE: "!=" >
|   < MENOR: "<" >
|   < MAIOR: ">" >

|   < MAIS: "+" >
|   < MENOS: "-" >
|   < VEZES: "*" >
|   < DIVIDIR: "/" >

|   < NUMERO: (["0"-"9"])+ ("." (["0"-"9"])+)? >
|   < STRING: "\"" (~["\"", "\n", "\r"])* "\"" >
|   < IDENTIFICADOR: ["a"-"z", "A"-"Z", "_"] (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
}

Comando programa() :
{
    Comando lista;
}
{
    lista = listaComandos() <EOF>
    {
        return lista;
    }
}

Comando bloco() :
{
    Comando lista = new BlocoCmd(new ArrayList<Comando>());
}
{
    <ABRE_CHAVE> [ lista = listaComandos() ] <FECHA_CHAVE>
    {
        return lista;
    }
}

Comando listaComandos() :
{
    List<Comando> comandos = new ArrayList<Comando>();
    Comando c;
}
{
    (
        c = comando()
        {
            comandos.add(c);
        }
    )+
    {
        return new BlocoCmd(comandos);
    }
}

Comando comando() :
{
    Comando c;
    Expressao e;
}
{
    LOOKAHEAD(2) c = atribCmd() { return c; }
|   c = condCmd() { return c; }
|   c = repetCmd() { return c; }
|   c = leitCmd() { return c; }
|   c = escrCmd() { return c; }
|   e = exp() [ <PONTO_VIRGULA> ] { return new EscrCmd(e); }
}

Comando atribCmd() :
{
    Token id;
    Expressao valor;
}
{
    id = <IDENTIFICADOR> <ATRIBUICAO> valor = exp() <PONTO_VIRGULA>
    {
        return new AtribCmd(id.image, valor);
    }
}

Comando condCmd() :
{
    Expressao cond;
    Comando bSe;
    Comando bSenao = null;
}
{
    <PA> <ABRE_PAR> cond = exp() <FECHA_PAR> bSe = bloco() [ LOOKAHEAD(1) <MU> bSenao = bloco() ]
    {
        return new CondCmd(cond, bSe, bSenao);
    }
}

Comando repetCmd() :
{
    Expressao cond;
    Comando corpo;
}
{
    ( <PARETIR> | <MUREPETI> ) <ABRE_PAR> cond = exp() <FECHA_PAR> corpo = bloco()
    {
        return new RepetCmd(cond, corpo);
    }
}

Comando leitCmd() :
{
    Token id;
}
{
    ( <MULER> | <PALER> ) <ABRE_PAR> id = <IDENTIFICADOR> <FECHA_PAR> [ <PONTO_VIRGULA> ]
    {
        return new LeitCmd(id.image);
    }
}

Comando escrCmd() :
{
    Expressao val;
    Token texto;
}
{
    ( <MUESCREVE> | <PAESCREVE> ) <ABRE_PAR>
    (
        texto = <STRING> <FECHA_PAR> [ <PONTO_VIRGULA> ]
        {
            String conteudo = texto.image.substring(1, texto.image.length() - 1);
            return new EscrCmd(conteudo);
        }
    |
        val = exp() <FECHA_PAR> [ <PONTO_VIRGULA> ]
        {
            return new EscrCmd(val);
        }
    )
}

Expressao exp() :
{
    Expressao esq;
    Expressao dir;
    String op;
}
{
    esq = expSimples()
    [
        op = opRelacional() dir = expSimples()
        {
            return new BinariaExp(esq, op, dir);
        }
    ]
    {
        return esq;
    }
}

String opRelacional() :
{
    Token op;
}
{
    ( op = <MENOR_IGUAL> | op = <MAIOR_IGUAL> | op = <IGUAL_DUPLO> | op = <DIFERENTE> | op = <MENOR> | op = <MAIOR> )
    {
        return op.image;
    }
}

Expressao expSimples() :
{
    Expressao total;
    Expressao proximo;
    String op;
}
{
    total = termo()
    (
        op = opSoma() proximo = termo()
        {
            total = new BinariaExp(total, op, proximo);
        }
    )*
    {
        return total;
    }
}

String opSoma() :
{
    Token op;
}
{
    ( op = <MAIS> | op = <MENOS> )
    {
        return op.image;
    }
}

Expressao termo() :
{
    Expressao total;
    Expressao proximo;
    String op;
}
{
    total = fator()
    (
        op = opMult()
        proximo = fator()
        {
            total = new BinariaExp(total, op, proximo);
        }
    |
        <ABRE_PAR> proximo = exp() <FECHA_PAR>
        {
            total = new BinariaExp(total, "*", proximo);
        }
    )*
    {
        return total;
    }
}

String opMult() :
{
    Token op;
}
{
    ( op = <VEZES> | op = <DIVIDIR> )
    {
        return op.image;
    }
}

Expressao fator() :
{
    Expressao e;
    Token t;
}
{
    <ABRE_PAR> e = exp() <FECHA_PAR> { return e; }
|   <MENOS> e = fator() { return new UnariaExp("-", e); }
|   <MAIS> e = fator() { return new UnariaExp("+", e); }
|   t = <NUMERO> { return new NumeroExp(Double.parseDouble(t.image)); }
|   t = <IDENTIFICADOR> { return new VariavelExp(t.image); }
}
